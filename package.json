{
  "name": "dead-deps-gauge",
  "version": "1.0.0",
  "description": "Find dependencies declared in package.json but never imported, and imports missing from package.json (or only in devDependencies). Understands ESM/CJS/TS, dynamic import, scripts, bins, config files and @types. Text/JSON/SARIF/Markdown, allowlist with expiry, GitHub Action. Zero deps.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "dead-deps-gauge": "bin/dead-deps-gauge.js"
  },
  "files": [
    "src",
    "bin",
    "action.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "dependencies",
    "unused-dependencies",
    "depcheck",
    "package-json",
    "imports",
    "dead-code",
    "lint",
    "sarif",
    "cli",
    "github-action"
  ],
  "author": "Louis Wright <hello@louiswright.co.uk> (https://github.com/MrLouisWright)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrLouisWright/dead-deps-gauge.git"
  },
  "bugs": {
    "url": "https://github.com/MrLouisWright/dead-deps-gauge/issues"
  },
  "homepage": "https://github.com/MrLouisWright/dead-deps-gauge#readme"
}
